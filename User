#pragma once
#include <string>
#include <vector>
#include "Message.h"

class User {
private:
    static const int MAX_FRIENDS = 40;

    int              userId;
    std::string      username;
    std::string      email;
    std::string      password;
    std::string      avatarUrl;
    bool             isAuthorized;
    std::vector<int> friends;   // ID друзей

public:
    User(int userId,
         const std::string& username,
         const std::string& email,
         const std::string& password);

    // Геттеры
    int                getUserId()       const;
    std::string        getUsername()     const;
    std::string        getEmail()        const;
    std::string        getAvatarUrl()    const;
    bool               getIsAuthorized() const;
    const std::vector<int>& getFriends() const;
    static int         getMaxFriends();

    // Авторизация
    bool login(const std::string& password);
    void logout();

    // Друзья
    bool addFriend(int friendId);
    bool removeFriend(int friendId);
    bool isFriend(int friendId) const;
    bool isFriendLimitReached() const;

    // Сообщения
    Message sendMessage(int receiverId,
                        MessageType type,
                        const std::string& text = "");
    void receiveMessage(const Message& message);

    void setAvatarUrl(const std::string& url);
};
