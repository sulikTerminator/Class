#pragma once
#include <string>

class Photo {
private:
    int         photoId;
    int         messageId;      // 0 — ещё не привязано
    std::string url;
    std::string thumbnailUrl;
    int         width;
    int         height;
    long long   sizeBytes;

public:
    Photo(int photoId,
          const std::string& url,
          const std::string& thumbnailUrl,
          int width,
          int height,
          long long sizeBytes);

    int         getPhotoId()   const;
    int         getMessageId() const;
    std::string getUrl()       const;
    std::string getThumbnail() const;
    int         getWidth()     const;
    int         getHeight()    const;
    long long   getSizeBytes() const;

    void bindToMessage(int messageId);
    std::string getPreview() const;
};
